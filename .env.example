# pet-report backend configuration (environment variables).
# The NixOS module sets these in production; for a manual run, export what you
# need. The pet roster and report preferences are set in the app, not here, and a
# saved profile overrides the matching value below (URLs, model, timezone,
# cameras) with no restart.

# Where the API listens (host:port).
PET_REPORT_LISTEN=127.0.0.1:8116

# Frigate NVR base URL. Cameras are auto-discovered from it; you never type feeds.
FRIGATE_URL=http://localhost:8114

# OpenAI-compatible vision model (e.g. served by llama-swap) and the model name.
# VISION_MODEL must match what your server calls the model; the value below is a
# placeholder to replace. A single-model llama.cpp ignores it and serves whatever is
# loaded, so it only has to be right when the server hosts more than one model.
LLAMA_SWAP_URL=http://localhost:8080
VISION_MODEL=vision-model

# IANA timezone for day boundaries and the morning/evening split.
PET_REPORT_TZ=UTC

# ntfy topic URL for the morning/evening push notifications. Environment-only (no
# in-app setting) and there is no off switch: leaving this unset falls back to the
# value below, which the batch will try and fail to reach if you do not run ntfy.
NTFY_URL=http://localhost:8106/pet-report

# Public URL of the web UI, used as the tap-through target for push notifications.
# PET_REPORT_PUBLIC_URL=http://localhost:8115

# Fallback camera list (comma-separated); the in-app profile supersedes this.
PET_CAMERAS=office

# Frigate object labels ingested as pet sightings.
PET_LABELS=dog,cat

# Frigate audio labels ingested as sound events.
PET_AUDIO_LABELS=bark,bow-wow,howl,growling,whimper_dog,meow,speech,yell,doorbell,ding-dong,knock,fire_alarm,smoke_detector,siren,car_alarm,glass,shatter,breaking,thump,bang

# Storage paths (default to an XDG data dir if unset).
# PET_REPORT_DB=/var/lib/pet-report/pet-report.db
# PET_REPORT_QUEUE=/var/lib/pet-report/queue
# PET_REPORT_PROOF_DIR=/var/lib/pet-report/proof
# PET_REPORT_MEDIA_DIR=/var/lib/pet-report/media   # owned copies of kept moments' media

# How often (seconds) to re-read Frigate's clip retention for the per-moment countdown.
# PET_REPORT_RETENTION_POLL_SECS=900

# Automation cadence (the serve process runs capture and batch itself, no external timer).
# PET_REPORT_CAPTURE_SECS=600      # queue a frame per online camera this often
# PET_REPORT_BATCH_HOURS=8,20      # local hours to run analysis, the report, and cleanup

# Minimum log severity: debug, info (default), warn, error. `debug` adds a line per HTTP
# request, every model round-trip with its latency, and routine pipeline detail.
# PET_REPORT_LOG_LEVEL=info
